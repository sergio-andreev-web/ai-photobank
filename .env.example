# Application environment
APP_ENV=local
APP_URL=http://localhost

# Database
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=photobank
DB_USERNAME=photobank
DB_PASSWORD=photobank_dev_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# File storage
PHOTO_STORAGE_DISK=local
PHOTO_STORAGE_ROOT=storage/app/photobank

# AI Service
AI_BASE_URL=http://ai-cpu:8000
AI_SERVICE_API_KEY=
AI_REQUEST_TIMEOUT=300

# AI Models and device
DEVICE=auto
VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct
EMBEDDING_MODEL=google/siglip2-so400m-patch14-384
HF_HOME=/models
PROMPT_VERSION=image-analysis-v1

# Tagging thresholds (starting values, to be tuned on validation dataset)
TAG_AUTO_ATTACH_THRESHOLD=0.82
TAG_CANDIDATE_THRESHOLD=0.68

# Optional: Debug and monitoring
DEBUG=false
LOG_LEVEL=info
