# Application environment
APP_ENV=local
APP_URL=http://localhost

# Database
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=photobank
DB_USERNAME=photobank
DB_PASSWORD=photobank_dev_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# File storage
PHOTO_STORAGE_DISK=local
PHOTO_STORAGE_ROOT=storage/app/photobank
# Upload size limit in bytes, default 50 MiB (ADR-0005). Must stay in sync with
# nginx client_max_body_size and PHP upload_max_filesize/post_max_size.
PHOTO_MAX_UPLOAD_BYTES=52428800

# AI Service
AI_BASE_URL=http://ai-cpu:8001
AI_SERVICE_API_KEY=
AI_REQUEST_TIMEOUT=300

# api-worker's `queue:work --timeout` (docker-compose.yml). Must stay greater
# than AI_REQUEST_TIMEOUT above — an AI-stage job (images.ai/images.reprocess)
# blocks on a single HTTP call to the AI service for up to AI_REQUEST_TIMEOUT
# seconds, and the worker kills the job if --timeout is reached first.
QUEUE_WORKER_TIMEOUT=360

# Active embedding version (ADR-0009, apps/api config). Only embeddings of
# this model_key + model_version (AI `models.embedding` without org prefix /
# `embedding_revision`) become active for semantic search; unset version
# means nothing is activated. Must match what the running AI service reports.
# Defaults match the mock AI of this stack (model mock-embedding, revision
# mock-embedding-v1). For real models (make ai-mac, RunPod) use
# siglip2-so400m-patch14-384 and the EMBEDDING_MODEL_REVISION value above.
EMBEDDING_ACTIVE_MODEL_KEY=mock-embedding
EMBEDDING_ACTIVE_MODEL_VERSION=mock-embedding-v1

# AI Models and device
DEVICE=auto
VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct
EMBEDDING_MODEL=google/siglip2-so400m-patch14-384
# Pinned embedding weights (HuggingFace commit). With real models (make ai-mac, RunPod)
# the AI reports this value as the embedding revision; set EMBEDDING_ACTIVE_MODEL_VERSION
# to the same value. The mock provider ignores it and reports mock-embedding-v1.
EMBEDDING_MODEL_REVISION=e8e487298228002f3d8a82e0cd5c8ea9c567f57f
# Docker/ai-cpu profile cache path (container-internal, backed by the
# ai_models_cache volume in docker-compose.yml). Not used by `make ai-mac` /
# `make ai-mac-cpu`, which run natively on the host — see AI_MAC_HF_HOME below.
HF_HOME=/models
PROMPT_VERSION=image-analysis-v3

# `make ai-mac` / `make ai-mac-cpu` (§8, §58): native macOS process, so its
# model cache must be a host path, not the container-only HF_HOME above.
# Persists HuggingFace weights across restarts (§68). Optional — defaults to
# ~/.cache/photobank-ai/huggingface if unset.
AI_MAC_HF_HOME=

# Tagging thresholds. Auto-attach only for word forms of an existing tag: SigLIP2 text
# similarity does not separate different concepts below ~0.92 (apps/api/config/photobank.php).
TAG_AUTO_ATTACH_THRESHOLD=0.92
TAG_CANDIDATE_THRESHOLD=0.68

# Optional: Debug and monitoring
DEBUG=false
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Public cloud / production profile (docker-compose.prod.yml)
# Commented out on purpose: `cp .env.example .env` (make setup, CI) must
# stay usable for local dev, and these values assume a real public HTTPS
# origin — e.g. SESSION_SECURE_COOKIE=true breaks login over plain local
# http, and the uncommented APP_URL below used to silently override the
# local-dev APP_URL set earlier in this file. Before `make prod-up`,
# uncomment this whole block and replace the example values with real ones
# from your hosting platform's secret store (systemd EnvironmentFile,
# Docker/Swarm secrets, Vault, cloud provider's env/secret panel, etc.) — do
# not commit real values.
# ---------------------------------------------------------------------------

# Laravel application key. Generate with: php artisan key:generate --show
# Left active (not commented out) unlike the rest of this block: every
# profile needs a real APP_KEY, and both `make setup`'s `.env` target and
# the CI integration smoke test fill in this exact `APP_KEY=` line via sed.
APP_KEY=

# Public origin. Nuxt + /api + /sanctum are served from this single origin
# behind nginx (ADR-0001) — no separate API domain, no CORS.
# NGINX_SERVER_NAME=photobank.example.com
# APP_URL=https://photobank.example.com

# Laravel session/Sanctum must trust the same public origin for stateful
# (cookie-based) auth once served over HTTPS behind nginx.
# SESSION_DOMAIN=photobank.example.com
# SESSION_SECURE_COOKIE=true
# SANCTUM_STATEFUL_DOMAINS=photobank.example.com
# nginx is the only client that ever talks to Laravel directly (single
# internal network), so its X-Forwarded-* headers should be trusted.
# Passed through by docker-compose.prod.yml but not read by Laravel: the
# backend trusts private-network proxies only (apps/api/bootstrap/app.php),
# which already covers nginx on the Compose network.
# TRUSTED_PROXIES=*

# TLS certificate and key, mounted read-only into the nginx container from
# NGINX_CERTS_DIR on the host (e.g. certbot output, or a cloud-issued cert).
# Not provided here — obtain and place them on the host before `make prod-up`.
# NGINX_CERTS_DIR=./certs
# NGINX_SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
# NGINX_SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
# NGINX_CLIENT_MAX_BODY_SIZE=50m

# Host directory for `make backup` / `make restore` snapshots.
# BACKUP_DIR=./backups

# Faces (ADR-0015): InsightFace buffalo_l on CPU inside the AI service. `make start` downloads the
# weights once (infra/scripts/fetch-face-model.sh, ~280 MB, non-commercial license). FACES_ENABLED=false
# turns the face contour off; everything else keeps working.
FACES_ENABLED=true
FACE_MODEL_DIR=
