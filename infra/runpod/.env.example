# AI Photobank — RunPod AI service environment (§58 RunPod profile, §67, §69).
#
# This is a *separate* env file for the RunPod Pod's container, not the
# project-root .env used by docker-compose.yml. RunPod Pods do not read
# docker-compose.yml — set these as the Pod's "Environment Variables" in the
# RunPod console (or `runpodctl` / GraphQL API) when creating/updating the Pod.
# Never commit a filled-in copy of this file.

# --- Model registry (§58 RunPod profile, §60) -------------------------------
DEVICE=cuda
AI_MODEL_PROVIDER=transformers
VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
# 4B is also allowed (§58) if the Pod's GPU/VRAM is constrained:
# VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct
EMBEDDING_MODEL=google/siglip2-so400m-patch14-384
# Pin exact weights once validated, instead of tracking a moving `main` branch.
VISION_MODEL_REVISION=main
EMBEDDING_MODEL_REVISION=main
DTYPE=auto

# --- Model cache (§67 "mount model cache", §68) ------------------------------
# Must resolve to a path inside the RunPod Network Volume mounted on the Pod
# (see README.md "Mount model cache") so weights survive Pod restarts/stop.
HF_HOME=/models/huggingface
# After the first successful start has populated HF_HOME, set to 1 to start
# without any outbound network call to huggingface.co.
HF_HUB_OFFLINE=0

# --- Service API key (§63, §67 "configure API key") --------------------------
# Required: with AI_ENVIRONMENT=production the service refuses to start when
# AI_SERVICE_API_KEY is empty (ADR-0010). Generate with `openssl rand -hex 32`; set the identical value on the
# Laravel host's AI_SERVICE_API_KEY (project-root .env / docker-compose.prod.yml
# deploy secret store). Never commit the real value.
AI_SERVICE_API_KEY=
AI_ENVIRONMENT=production

# --- Concurrency / limits (§58, tune to the Pod's GPU) -----------------------
AI_CONCURRENCY=1
PROMPT_VERSION=image-analysis-v1
