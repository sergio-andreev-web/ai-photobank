# Production vhost template for the public cloud profile
# (docker-compose.prod.yml). Rendered to /etc/nginx/conf.d/default.conf by
# the official nginx entrypoint (envsubst-on-templates) using the
# NGINX_SERVER_NAME / NGINX_SSL_CERT_PATH / NGINX_SSL_KEY_PATH /
# NGINX_CLIENT_MAX_BODY_SIZE variables set in docker-compose.prod.yml.
#
# Only these ${...} placeholders are substituted (see NGINX_ENVSUBST_FILTER
# on the nginx service) — nginx's own runtime $variables (e.g. $host,
# $remote_addr, $scheme) are left untouched.

upstream api {
    server api:8000;
}

upstream admin {
    server admin:3000;
}

# Plain HTTP: only used for the ACME HTTP-01 challenge and load-balancer
# health probes. Everything else is redirected to HTTPS.
server {
    listen 80 default_server;
    server_name ${NGINX_SERVER_NAME};

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "OK";
    }

    # Optional extension point for certbot HTTP-01 renewal: mount a shared
    # webroot at /var/www/certbot on this service and on the certbot
    # container if you automate renewal. Unused (404s) otherwise.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate ${NGINX_SSL_CERT_PATH};
    ssl_certificate_key ${NGINX_SSL_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    server_tokens off;

    # 50 MiB, matching PHOTO_MAX_UPLOAD_BYTES default (ADR-0005).
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    client_body_timeout 120s;
    proxy_read_timeout 120s;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "OK";
    }

    # Single origin for Nuxt + /api + /sanctum (ADR-0001) — no CORS needed.
    location /api/ {
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $http_x_request_id;
    }

    location /sanctum/ {
        proxy_pass http://api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Protected media (§57, §63): only reachable via Laravel's
    # X-Accel-Redirect after backend authorization — never served directly.
    location /_protected/ {
        internal;
        alias /var/www/photobank/storage/app/photobank/;
    }

    location / {
        proxy_pass http://admin;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ /\.(env|git) {
        deny all;
    }
}
