{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-photobank.local/contracts/schemas/text-embeddings.json",
  "title": "Text embeddings request/response",
  "description": "POST /v1/embeddings/text (§32). Используется TagResolver stage 3 (§36), генерацией tag_embeddings (§21) и semantic search (§42). Лимиты batch — утверждено (ADR-0010).",
  "$defs": {
    "TextEmbeddingsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["texts"],
      "x-tz": "§32",
      "properties": {
        "texts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "x-constraints": ["maxItems", "items.maxLength"],
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        }
      }
    },
    "TextEmbeddingsResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "revision", "dimensions", "embeddings"],
      "x-tz": "§32",
      "description": "embeddings[i] соответствует texts[i]; длина embeddings равна длине texts (проверяется клиентом, JSON Schema этого не выражает).",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "description": "Например google/siglip2-so400m-patch14-384. Должно совпадать с models.embedding из анализа изображений той же версии."
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-adr": "ADR-0009",
          "description": "Ревизия весов embedding-модели; равна models.embedding_revision анализа."
        },
        "dimensions": { "const": 1152 },
        "embeddings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "array",
            "minItems": 1152,
            "maxItems": 1152,
            "items": { "type": "number" }
          }
        }
      }
    }
  }
}
