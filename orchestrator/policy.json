{
  "version": 3,
  "providers": ["codex", "claude"],
  "allowed_models": {
    "codex": ["gpt-6-luna", "gpt-6-sol"],
    "claude": ["claude-haiku-4-5", "claude-sonnet-5", "claude-opus-5-5", "claude-fable-5-1"]
  },
  "usage_routing": {"switch_margin_percent": 10, "minimum_remaining_percent": 5},
  "modules": {
    "contracts": {"brief": "docs/agent-tasks/00-contracts.md", "owned_paths": ["contracts/", "docs/adr/"]},
    "backend": {"brief": "docs/agent-tasks/01-backend.md", "owned_paths": ["apps/api/"]},
    "frontend": {"brief": "docs/agent-tasks/02-admin-frontend.md", "owned_paths": ["apps/admin/"]},
    "ai": {"brief": "docs/agent-tasks/03-ai-service.md", "owned_paths": ["services/ai/"]},
    "infra": {"brief": "docs/agent-tasks/04-infrastructure.md", "owned_paths": ["infra/", "docker-compose.yml", "docker-compose.mac.yml", "Makefile", ".env.example", ".github/"]},
    "qa": {"brief": "docs/agent-tasks/05-integration-qa.md", "owned_paths": ["tests/contracts/", "tests/e2e/", "docs/qa/"]}
  },
  "routes": {
    "architecture": {"default_provider": "claude", "codex": {"model": "gpt-6-sol", "effort": "high"}, "claude": {"model": "claude-opus-5-5", "effort": "high"}},
    "simple_contract": {"default_provider": "claude", "codex": {"model": "gpt-6-luna", "effort": "medium"}, "claude": {"model": "claude-haiku-4-5", "effort": ""}},
    "standard": {"default_provider": "claude", "codex": {"model": "gpt-6-sol", "effort": "medium"}, "claude": {"model": "claude-sonnet-5", "effort": "medium"}},
    "standard_high": {"default_provider": "codex", "codex": {"model": "gpt-6-sol", "effort": "high"}, "claude": {"model": "claude-sonnet-5", "effort": "high"}},
    "migration_simple": {"default_provider": "codex", "codex": {"model": "gpt-6-luna", "effort": "medium"}, "claude": {"model": "claude-haiku-4-5", "effort": ""}},
    "schema_complex": {"default_provider": "claude", "codex": {"model": "gpt-6-sol", "effort": "high"}, "claude": {"model": "claude-sonnet-5", "effort": "high"}},
    "critical_domain": {"default_provider": "claude", "codex": {"model": "gpt-6-sol", "effort": "high"}, "claude": {"model": "claude-opus-5-5", "effort": "high"}},
    "frontend_simple": {"default_provider": "codex", "codex": {"model": "gpt-6-luna", "effort": "medium"}, "claude": {"model": "claude-haiku-4-5", "effort": ""}},
    "frontend_flow": {"default_provider": "claude", "codex": {"model": "gpt-6-sol", "effort": "medium"}, "claude": {"model": "claude-sonnet-5", "effort": "medium"}},
    "ai_mock": {"default_provider": "claude", "codex": {"model": "gpt-6-sol", "effort": "medium"}, "claude": {"model": "claude-sonnet-5", "effort": "medium"}},
    "complex_technical": {"default_provider": "claude", "codex": {"model": "gpt-6-sol", "effort": "high"}, "claude": {"model": "claude-opus-5-5", "effort": "high"}},
    "infra_simple": {"default_provider": "codex", "codex": {"model": "gpt-6-luna", "effort": "medium"}, "claude": {"model": "claude-haiku-4-5", "effort": ""}},
    "infra_deploy": {"default_provider": "codex", "codex": {"model": "gpt-6-sol", "effort": "high"}, "claude": {"model": "claude-sonnet-5", "effort": "high"}},
    "integration": {"default_provider": "claude", "codex": {"model": "gpt-6-sol", "effort": "high"}, "claude": {"model": "claude-opus-5-5", "effort": "high"}}
  },
  "ollama": {
    "enabled": false,
    "model": "",
    "allowed_kinds": ["simple_contract", "migration_simple", "frontend_simple", "infra_simple"]
  }
}
